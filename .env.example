# Public site URL (Open Graph / absolute links)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 15-minute booking link — Cal.com or Calendly event URL (opens in new tab; works on mobile)
# NEXT_PUBLIC_SCHEDULE_URL=https://cal.com/yourusername/15min

# Optional: extra LAN dev hosts for Next.js HMR (see README)
# ALLOWED_DEV_ORIGINS=172.16.0.5
